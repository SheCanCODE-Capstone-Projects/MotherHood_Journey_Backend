AT_API_KEY=replace_with_africas_talking_api_key
AT_USERNAME=replace_with_africas_talking_username

NIDA_API_BASE_URL=https://api.nida.gov.rw/v1
NIDA_API_KEY=replace_with_nida_api_key

IREMBO_API_BASE_URL=https://api.irembo.gov.rw/v1
IREMBO_API_KEY=replace_with_irembo_api_key
# ─────────────────────────────────────────────
# DOCKER IMAGE CONFIGURATION
# ─────────────────────────────────────────────
DOCKER_HUB_USERNAME=
DOCKER_IMAGE_NAME=
DOCKER_IMAGE_TAG=v1.0.0

# ─────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# CORS (comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─────────────────────────────────────────────
# DATABASE CONFIGURATION (USED BY BOTH SERVICES)
# ─────────────────────────────────────────────
DB_NAME=
# if you are running these in a docker container make sure to change the localhost to postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

# ─────────────────────────────────────────────
# JWT CONFIGURATION
# ─────────────────────────────────────────────
JWT_SECRET=replace_with_strong_random_secret_key
JWT_EXPIRATION_MS=86400000

# ─────────────────────────────────────────────
# OPTIONAL / FUTURE INTEGRATIONS
# ─────────────────────────────────────────────

# SMS Provider (Africa's Talking or similar)
AT_API_KEY=your_api_key
AT_USERNAME=your_username

# ─────────────────────────────────────────────
# Port of postgres in Docker container
# ─────────────────────────────────────────────
POSTGRES_PORT=

# Government integrations (fill with real credentials when available)
# Temporary values are fine for startup as long as the gov sync endpoints are not called.

# NIDA
NIDA_API_BASE_URL=https://api.nida.gov.rw/v1
NIDA_API_KEY=replace_with_nida_api_key

# IREMBO
IREMBO_API_BASE_URL=https://api.irembo.gov.rw/v1
IREMBO_API_KEY=replace_with_irembo_api_key

