# ─────────────────────────────────────────────
# DOCKER IMAGE CONFIGURATION
# ─────────────────────────────────────────────
DOCKER_HUB_USERNAME=your_dockerhub_username
DOCKER_IMAGE_NAME=motherhood-journey
DOCKER_IMAGE_TAG=latest

# ─────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────
APP_PORT=8080
# prod       → production Spring settings (connection pool, logging)
# mock       → activates embedded mock gov-API controllers (NIDA, Irembo, HMIS)
#              served at /mock/nida  /mock/irembo  /mock/hmis within this app
# Examples:
#   prod        — real gov APIs (requires IREMBO/HMIS/NIDA URLs below)
#   prod,mock   — production settings + embedded mock gov APIs
#   local,mock  — local dev + mock gov APIs
SPRING_PROFILES_ACTIVE=prod,mock

# ─────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────
# Docker Compose: "postgres" is the service name on the internal network.
# Outside Docker (Railway managed DB): set SPRING_DATASOURCE_URL instead.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=motherhood_journey
DB_USERNAME=postgres
DB_PASSWORD=replace_with_strong_password

# Full JDBC URL — set this on Railway / managed DB hosting; leave commented for docker-compose.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<dbname>
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_strong_password

# Exposed host port for the local Postgres container (Docker Compose only)
POSTGRES_PORT=5433

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
# Full Redis URL — works locally and with Railway / Upstash / etc.
# Format: redis://[username:password@]host:port[/db]
# Local Docker:  redis://localhost:6379
# Railway:       redis://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379
# Exposed host port for the local Redis container (Docker Compose only)
REDIS_PORT=6379

# ─────────────────────────────────────────────
# JWT CONFIGURATION
# ─────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace_with_strong_random_secret_min_64_chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─────────────────────────────────────────────
# ACCOUNT LOCKOUT
# ─────────────────────────────────────────────
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# ─────────────────────────────────────────────
# APPOINTMENT SETTINGS
# ─────────────────────────────────────────────
APPOINTMENT_SLOT_MINUTES=30
APPOINTMENT_MAX_PER_SLOT=10

# ─────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────
STORAGE_LOCAL_ROOT=./uploads
# Max file size in bytes (default 10 MB)
STORAGE_MAX_FILE_SIZE=10485760

# ─────────────────────────────────────────────
# AFRICA'S TALKING SMS
# ─────────────────────────────────────────────
AT_API_KEY=replace_with_africas_talking_api_key
AT_USERNAME=sandbox

# ─────────────────────────────────────────────
# GOVERNMENT INTEGRATIONS
# When SPRING_PROFILES_ACTIVE includes "mock", the embedded mock controllers
# override all three base-URLs automatically (see application-mock.yml).
# Leave empty when using mock profile; fill in for real gov API access.
# ─────────────────────────────────────────────
IREMBO_BASE_URL=
IREMBO_API_KEY=

HMIS_BASE_URL=
HMIS_API_KEY=

NIDA_BASE_URL=
NIDA_API_KEY=

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# Comma-separated list of allowed front-end origins.
# Example: https://app.yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# ESCALATION
# ─────────────────────────────────────────────
ESCALATION_PENDING_HOURS=48
